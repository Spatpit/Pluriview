<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Viewer" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/panel</item>
        <item name="android:colorPrimaryDark">@color/panel</item>
        <item name="android:colorAccent">@color/gold</item>
        <item name="android:colorControlActivated">@color/gold</item>
        <item name="android:colorBackground">@color/panel</item>
        <item name="android:windowBackground">@color/panel</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/secondary</item>
        <item name="android:textColorHint">@color/secondary</item>
        <item name="android:statusBarColor">@color/panel</item>
        <item name="android:navigationBarColor">@color/panel</item>
        <item name="android:alertDialogTheme">@style/ViewerDialog</item>
    </style>
    <style name="ViewerDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/gold</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/secondary</item>
    </style>
</resources>
